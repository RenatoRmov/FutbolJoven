# Dev default: local SQLite file, zero setup required.
DATABASE_URL="file:./dev.db"

# To use PostgreSQL instead (recommended for production — see README
# "Switching to PostgreSQL"): set the provider in prisma/schema.prisma
# back to "postgresql" and point this at your instance, e.g.
# DATABASE_URL="postgresql://futboljoven:password@localhost:5432/futboljoven?schema=public"

JWT_ACCESS_SECRET="change-me-access-secret-min-32-chars-long"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-chars-long"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"
API_PORT=3001
WEB_ORIGIN="http://localhost:3000"
UPLOADS_DIR="./uploads"
