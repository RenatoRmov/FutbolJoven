{
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter @futboljoven/shared build && pnpm --filter @futboljoven/web build",
  "outputDirectory": "apps/web/.next",
  "framework": "nextjs",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://futboljoven-api-iota.vercel.app/api/:path*"
    }
  ]
}
