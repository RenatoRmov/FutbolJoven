# --- PostgreSQL (docker-compose) ---
POSTGRES_USER=futboljoven
POSTGRES_PASSWORD=futboljoven_dev_password
POSTGRES_DB=futboljoven
POSTGRES_PORT=5432

# --- apps/api ---
DATABASE_URL="postgresql://futboljoven:futboljoven_dev_password@localhost:5432/futboljoven?schema=public"
JWT_ACCESS_SECRET="change-me-access-secret-min-32-chars-long"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-chars-long"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"
API_PORT=3001
WEB_ORIGIN="http://localhost:3000"
UPLOADS_DIR="./uploads"

# --- apps/web ---
NEXT_PUBLIC_API_URL="http://localhost:3001"
