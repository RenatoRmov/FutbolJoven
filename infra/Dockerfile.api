# Build context is the repo root (monorepo) — on Railway, set:
#   Dockerfile Path: infra/Dockerfile.api
#   Root Directory:  . (repo root, default)
FROM node:20-alpine AS base
RUN corepack enable
WORKDIR /app

FROM base AS build
COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @futboljoven/shared build
RUN pnpm --filter @futboljoven/api exec prisma generate --schema=prisma/schema.production.prisma
RUN pnpm --filter @futboljoven/api build

FROM base AS runner
ENV NODE_ENV=production
COPY --from=build /app /app
WORKDIR /app/apps/api
EXPOSE 3001
# Pushes the current schema to the DB on boot (fresh/empty production DB —
# see prisma/schema.production.prisma for why `db push` instead of
# `migrate deploy` at this stage) then starts the compiled server.
CMD ["sh", "-c", "npx prisma db push --schema=prisma/schema.production.prisma --skip-generate --accept-data-loss && node dist/main.js"]
